#!/usr/bin/env bash
# Arch dispatcher for the bundled gdiff2 builds.
# Point scripts here instead of at a specific binary so they run on
# macOS (arm64) and Linux (x86-64) without edits.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64)             exec "$HERE/gdiff2-osx" "$@" ;;
  Linux/x86_64|Linux/amd64) exec "$HERE/gdiff2-x86" "$@" ;;
  *)
    echo "gdiff2: unsupported platform $(uname -s)/$(uname -m)" >&2
    exit 127
    ;;
esac
